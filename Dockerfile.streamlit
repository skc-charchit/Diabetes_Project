FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
COPY README.md ./
RUN uv sync --frozen --no-dev --extra ui --no-install-project

COPY app.py .
COPY src ./src
RUN uv sync --frozen --no-dev --extra ui
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

CMD ["sh", "-c", "uv run --frozen --no-dev --extra ui streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true"]